# ============================================================
# 博客生产环境变量配置
# 复制此文件为 .env.production 并填入真实值
# ============================================================

# --- 数据库 ---
# PostgreSQL 密码（必填）
POSTGRES_PASSWORD=change-this-to-a-strong-password

# --- JWT（必填）---
# 用于签发和验证 JWT Token，请使用强随机字符串
# 示例生成：openssl rand -base64 64
JWT_SECRET=change-this-to-a-very-long-random-string

# JWT 过期时间（可选，默认值合理）
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=168h

# --- 服务器 ---
# 前端访问地址（可选，默认 http://localhost）
# SERVER_FRONTEND_URL=http://localhost

# --- GitHub OAuth（可选）---
# 不配置则 GitHub 登录功能不可用
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URL=http://your-domain.com/api/v1/auth/github/callback
# ADMIN_GITHUB_ID=

# --- 管理员账户 ---
# 首次启动时自动创建管理员（可选，有默认值）
# ADMIN_EMAIL=admin@blog.local
ADMIN_PASSWORD=change-this-to-a-strong-password

# --- AI 摘要（可选）---
# 不配置则 AI 摘要功能不可用
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
